//PAYROLLJ JOB (ACCT),'MONTHLY',CLASS=A,MSGCLASS=X
//*  Monthly payroll batch job.
//STEP010  EXEC PGM=PAYROLL
//STEPLIB  DD   DSN=PROD.LOADLIB,DISP=SHR
//PAYIN    DD   DSN=PROD.PAYROLL.MASTER,DISP=SHR
//PAYOUT   DD   DSN=PROD.PAYROLL.DAILY(+1),
//             DISP=(NEW,CATLG,DELETE)
//SYSOUT   DD   SYSOUT=*
//STEP020  EXEC PGM=AUDITWR
//AUDIN    DD   DSN=PROD.PAYROLL.DAILY(0),DISP=SHR
//AUDOUT   DD   DSN=PROD.AUDIT.LOG,DISP=MOD
