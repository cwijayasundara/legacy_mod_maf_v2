          "tests_passed": true,
          "reviewer_notes": "{\"verdict\":\"revise\",\"findings\":[{\"severity\":\"error\",\"rule\":\"linkage-signature-mismatch\",\"file\":\"src/main/java/com/example/intcalc/service/IntcalcService.java\",\"line\":14,\"message\":\"Public service method signature does not preserve the COBOL PROCEDURE DIVISION USING linkage as a single ordered record/object matching LNK-BALANCE, LNK-RATE, LNK-INTEREST, and LNK-STATUS.\"},{\"severity\":\"error\",\"rule\":\"linkage-signature-mismatch\",\"file\":\"src/main/java/com/example/intcalc/service/IntcalcService.java\",\"line\":17,\"message\":\"LNK-INTEREST is an output linkage item but is modeled as an input BigDecimal parameter and returned separately instead of being part of the callable linkage structure.\"},{\"severity\":\"error\",\"rule\":\"linkage-signature-mismatch\",\"file\":\"src/main/java/com/example/intcalc/service/IntcalcService.java\",\"line\":18,\"message\":\"LNK-STATUS in COBOL is a two-field linkage record with PIC X(1) and PIC X(30), but the service API uses a separate DTO outside the declared linkage wrapper and breaks the original USING contract.\"},{\"severity\":\"error\",\"rule\":\"linkage-signature-mismatch\",\"file\":\"src/main/java/com/example/intcalc/dto/IntcalcLinkage.java\",\"line\":21,\"message\":\"lnkMsg is constrained to 20 characters, but COBOL LNK-MSG is PIC X(30) and must allow up to 30 characters.\"},{\"severity\":\"error\",\"rule\":\"linkage-signature-mismatch\",\"file\":\"src/main/java/com/example/intcalc/dto/IntcalcLinkage.java\",\"line\":10,\"message\":\"lnkBalance is declared with 18 integer digits and 2 fractional digits, but COBOL LNK-BALANCE PIC S9(7)V99 allows 7 integer digits and 2 fractional digits.\"},{\"severity\":\"error\",\"rule\":\"linkage-signature-mismatch\",\"file\":\"src/main/java/com/example/intcalc/dto/IntcalcLinkage.java\",\"line\":14,\"message\":\"lnkRate is declared with 9 fractional digits, but COBOL LNK-RATE PIC 9(1)V999 allows 1 integer digit and 3 fractional digits.\"},{\"severity\":\"error\",\"rule\":\"linkage-signature-mismatch\",\"file\":\"src/main/java/com/example/intcalc/dto/IntcalcLinkage.java\",\"line\":17,\"message\":\"lnkInterest is declared with 18 integer digits and 9 fractional digits, but COBOL LNK-INTEREST PIC S9(7)V99 allows 7 integer digits and 2 fractional digits.\"}],\"suggested_fix\":\"Change the service to expose a single callable method that accepts and returns one IntcalcLinkage record matching the COBOL USING layout exactly, and correct IntcalcLinkage field sizes so balance/interest are S9(7)V99, rate is 9(1)V999, and lnkMsg is X(30).\"}",
