//STMTGENJ JOB (ACCT),'MONTHLY STMT',CLASS=A,MSGCLASS=X
//*  Monthly statement generation pipeline.
//STEP010  EXEC PGM=STMTGEN
//STEPLIB  DD   DSN=PROD.LOADLIB,DISP=SHR
//CUSTIN   DD   DSN=PROD.CUST.MASTER,DISP=SHR
//STMTOUT  DD   DSN=PROD.STMT.DAILY(+1),
//             DISP=(NEW,CATLG,DELETE)
//SYSOUT   DD   SYSOUT=*
//STEP020  EXEC PGM=INTCALC
//*  INTCALC is also exposed as a batch-callable for ad-hoc re-accruals.
//INTIN    DD   DSN=PROD.STMT.DAILY(0),DISP=SHR
//INTOUT   DD   DSN=PROD.INT.ACCRUAL(+1),DISP=(NEW,CATLG,DELETE)
