# =============================================================================
# LLM provider — pick one and fill in credentials.
# =============================================================================
# Autodetected from which creds are set below, or force explicitly.
# One of: openai | azure-openai | azure-claude | anthropic
LEGACY_MOD_PROVIDER=openai

# --- OpenAI (default) ------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Azure OpenAI ---------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure Claude (Anthropic on Azure AI Foundry) -------------------------
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_RESOURCE=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Anthropic (direct) ---------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Ollama (local inference, OpenAI-compatible endpoint) -----------------
# Requires: `ollama serve` running and the target model pulled.
# Check what you have with `ollama ls`; paste the NAME column value into
# OLLAMA_MODEL (including any `:tag`).
# Cost is always $0 for local inference — MAX_BUDGET_USD still loads as a
# safety net but never halts an Ollama run.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.6:latest        # e.g. qwen3.6:latest, qwen3:14b, llama3.1:8b
OLLAMA_API_KEY=ollama              # placeholder — Ollama ignores it

# =============================================================================
# run_migration.py — source, target, and run settings.
# =============================================================================
# Relative paths are resolved against the repo root.
SOURCE_DIR=aws_legacy/generated_code
MIGRATED_DIR=azure_fn_migrated
REPO_ID=legacy-aws
CARTRIDGE=aws_lambda_polyglot_to_azure_fn_py

MAX_PARALLEL=2                # parallel unit-workers per wave (1 = fully sequential, safest for cost)
MAX_BUDGET_USD=10.0           # HARD cap in USD — run halts when reached
                              # pricing table lives in platform_core/maf_workflows/budget.py
DRY_RUN=0                     # 1 = plan-only, no LLM calls
POLL_INTERVAL_S=15            # progress reprint cadence

# =============================================================================
# Platform knobs.
# =============================================================================
LEGACY_MOD_LOG_LEVEL=INFO

# Wave verification: set to 1 to require the Azure emulator stack
# (Azurite + Service Bus + Cosmos) to be up; otherwise missing emulators are
# soft-passed. Requires `docker compose -f docker-compose.emulators.yaml up -d`.
LEGACY_MOD_REQUIRE_EMULATORS=0
